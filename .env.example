# ================================================================
# SafeDeal 환경 변수 예시 — 실제 값으로 채운 후 .env로 복사하세요
# cp .env.example .env
# ================================================================

# == 데이터베이스 (로컬 직접 실행 시) ==
DB_URL=jdbc:mysql://localhost:3306/safedeal?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=your_db_password_here
DB_DRIVER=com.mysql.cj.jdbc.Driver

# == Redis ==
REDIS_HOST=localhost
REDIS_PORT=6379

# == Kafka ==
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# == 서버 ==
SERVER_PORT=8080

# == JWT ==
JWT_SECRET=your_base64_jwt_secret_here
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=86400000

# == 뷰 카운트 ==
VIEW_IP_SECRET=your_view_ip_secret_here

# == 포트원 결제 ==
PORTONE_DIRECT_CHANNEL_KEY=
PORTONE_DIRECT_SECRET=
PORTONE_AUTO_CHANNEL_KEY=
PORTONE_AUTO_SECRET=
PORTONE_SECRET=
PORTONE_WEBHOOK_SECRET=

# == ngrok (로컬 웹훅 테스트용) ==
NGROK_AUTHTOKEN=

# == Grafana (로컬 모니터링) ==
GRAFANA_ADMIN_PASSWORD=your_grafana_admin_password_here
