# ================================================================
# SafeDeal 환경 변수 예시 — 실제 값으로 채운 후 .env로 복사하세요
# cp .env.example .env
#
# .env는 Spring이 properties 문법으로 읽는다(application.yml의 spring.config.import).
# 값에 백슬래시가 들어가면 이스케이프로 해석돼 사라지므로 \\ 로 두 번 써야 한다.
# ================================================================

# == 실행 프로파일 ==
# 이 값이 없으면 local 프로파일이 안 켜져서 개발용 인증과 API 문서가 꺼진 채로 뜬다.
# 여기서만 점 표기법을 쓰는 이유: .env는 properties 파일로 읽히므로 환경변수의
# SPRING_PROFILES_ACTIVE -> spring.profiles.active 자동 변환이 적용되지 않는다.
# (대문자 형태로 적으면 조용히 무시되고 default 프로파일로 뜬다 — 실측 확인함)
# 운영 배포에서는 .env가 아니라 컨테이너 환경변수로 prod를 주입한다.
spring.profiles.active=local

# == 데이터베이스 (로컬 직접 실행 시) ==
# serverTimezone은 반드시 UTC로 둔다. DB·JVM 모두 UTC로 저장하고 화면 표시 시점에만
# KST로 변환하는 것이 확정 정책이라(application.yml의 hibernate.jdbc.time_zone도 UTC),
# 로컬만 Asia/Seoul로 두면 시간 관련 버그가 로컬과 운영에서 다르게 재현된다.
DB_URL=jdbc:mysql://localhost:3306/safedeal?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=your_db_password_here
DB_DRIVER=com.mysql.cj.jdbc.Driver

# == Redis ==
REDIS_HOST=localhost
REDIS_PORT=6379

# == Kafka ==
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# == 서버 ==
SERVER_PORT=8080

# == JWT ==
JWT_SECRET=your_base64_jwt_secret_here
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=86400000

# == 뷰 카운트 ==
VIEW_IP_SECRET=your_view_ip_secret_here

# == 포트원 결제 ==
PORTONE_DIRECT_CHANNEL_KEY=
PORTONE_DIRECT_SECRET=
PORTONE_AUTO_CHANNEL_KEY=
PORTONE_AUTO_SECRET=
PORTONE_SECRET=
PORTONE_WEBHOOK_SECRET=

# == ngrok (로컬 웹훅 테스트용) ==
NGROK_AUTHTOKEN=

# == Grafana (로컬 모니터링) ==
GRAFANA_ADMIN_PASSWORD=your_grafana_admin_password_here
